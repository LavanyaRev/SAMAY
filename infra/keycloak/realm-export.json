{
  "realm": "samay",
  "displayName": "SAMAY — Smart AICTE Monitoring & Approval Yojana",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "INSTITUTION",
        "description": "Institutional applicant and administration role"
      },
      {
        "name": "REGIONAL_OFFICER",
        "description": "AICTE Regional Officer monitoring regional jurisdiction"
      },
      {
        "name": "BUREAU_OFFICER",
        "description": "AICTE Central Approval Bureau Officer"
      },
      {
        "name": "COMMITTEE_MEMBER",
        "description": "Statutory Committee Expert (Scrutiny / EVC / SAC)"
      },
      {
        "name": "ADMIN",
        "description": "System Administrator with full platform oversight"
      }
    ]
  },
  "groups": [],
  "clients": [
    {
      "clientId": "samay-web",
      "name": "SAMAY Web Frontend",
      "description": "SPA Web Application using PKCE flow",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    },
    {
      "clientId": "samay-api",
      "name": "SAMAY Backend API",
      "description": "Resource server for bearer token validation",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
