# ==============================================================================
# SAMAY (Smart AICTE Monitoring & Approval Yojana) - Environment Configuration
# ==============================================================================
# Notice: Copy this file to .env or .env.local for local overrides.
# Never commit credentials, private keys, or passwords to version control.
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API (NestJS - apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
JWT_SECRET=samay-regulatory-dev-secret-key-32chars-minimum-entropy
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Database & PostgreSQL / pgvector (packages/database)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://samay_app:samay_app_password@localhost:5432/samay_db?schema=public"
TEST_DATABASE_URL="postgresql://samay_app:samay_app_password@localhost:5432/samay_test_db?schema=public"

# ------------------------------------------------------------------------------
# Frontend Portal (Next.js 15 - apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
API_INTERNAL_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# Identity & Access Management (Keycloak)
# ------------------------------------------------------------------------------
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="samay"
KEYCLOAK_CLIENT_ID="samay-portal"

# ------------------------------------------------------------------------------
# Notification Gateway (Mailpit / SMTP Sandbox)
# ------------------------------------------------------------------------------
MAILPIT_SMTP_HOST="127.0.0.1"
MAILPIT_SMTP_PORT=1025
SMS_GATEWAY_PROVIDER="MOCK_SANDBOX"

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3 - Affidavit & Document Storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET_DOCS="samay-documents"
